# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Local MongoDB:   mongodb://127.0.0.1:27017/chatnest
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatnest
MONGODB_URI=mongodb://127.0.0.1:27017/chatnest

# Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Folder (relative to the project root) where uploaded images are stored.
UPLOAD_DIR=uploads

# Frontend origin allowed by CORS and Socket.IO, e.g. http://localhost:5173. "*" allows any origin.
CORS_ORIGIN=*
